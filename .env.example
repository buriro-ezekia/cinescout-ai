# CineScout AI local configuration
# Copy this file to .env and fill in the values you intend to use.

# Recommended hackathon path: Vertex AI / Google Cloud
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global

# Model used by the Phase 1 vertical slice.
CINESCOUT_MODEL=gemini-3.6-flash

# Parallel Search MCP is free for light anonymous use, so no API key is required.
PARALLEL_MCP_URL=https://search.parallel.ai/mcp

# Optional: add a Parallel API key later for higher rate limits.
PARALLEL_API_KEY=
